# Copy to .env and fill in. Never commit .env.
# All values are placeholders — no real secrets belong here.

# Translation provider (OpenAI-compatible endpoint)
# Local alternative with zero cloud egress (e.g. Ollama):
# TRANSLATE_BASE_URL=http://localhost:11434/v1
TRANSLATE_BASE_URL=https://api.example.com/v1
TRANSLATE_API_KEY=sk-example-placeholder
TRANSLATE_MODEL=gpt-4o-mini

# Gate fan-out parallelism: max concurrent translation legs per /send.
# Generous default; lower it if the provider rate-limits (429s).
GATE_CONCURRENCY=4

# Telegram (official Bot API)
TELEGRAM_BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Leave empty to auto-discover via: node --env-file=.env .\adapters\telegram\discover.ts
TELEGRAM_CHAT_ID=

# Discord (official API)
DISCORD_BOT_TOKEN=MTEx111.example-placeholder
DISCORD_CHANNEL_ID=000000000000000000
# Discord executor (adapters/discord/runner.ts): the one process that calls
# the Discord API. Polls core /outbox, sends, acks; reads the channel back
# into /ingress. Gap/cap have floors (1 s, 2000/day) that settings cannot
# go below.
CORE_BASE_URL=http://localhost:8787
DISCORD_POLL_SECS=3
DISCORD_MIN_GAP_SECS=2
DISCORD_DAILY_CAP=200
DISCORD_BACKFILL=0

# Slack (official API, P2) — placeholder intentionally avoids the live token prefix
SLACK_BOT_TOKEN=slack-example-placeholder
SLACK_CHANNEL_ID=C00000000

# Core server
PORT=8787
# Listen address. Loopback by default: only this machine can reach the
# core. Opening it to the LAN (e.g. 0.0.0.0 for the phone) REQUIRES a token
# below, or the core refuses to start.
HOST=127.0.0.1
# Shared bearer token. When set, every call except /health must carry
# `Authorization: Bearer <token>`: the discord runner and the phone app
# send it, the hub dev proxy attaches it for the browser. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CORE_AUTH_TOKEN=
LEDGER_PATH=./data/ledger.jsonl
BINDINGS_PATH=./core/bindings.example.json
HUB_ORIGIN=http://localhost:5173
# Relay whitelist: JSON array of directional {from,to} channel pairs whose
# derived (inbound-triggered) copies may actually be sent. Empty = locked:
# only hub/cowork-originated sends leave; everything derived is record-only.
RELAY_PATH=./core/relay.example.json
